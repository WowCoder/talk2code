# Talk2Code 中间件口令模板
#
# 用法：
#   cp .env.example .env        # 本文件是模板，.env 才是 docker compose 实际读取的文件
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"   # 生成随机口令
#
# ⚠️ .env 已被 .gitignore 忽略，切勿把真实口令写进本文件（本文件入库）。

# PostgreSQL 口令（必填）
# 修改后需同步更新 backend/.env 的 DATABASE_URL：
#   postgresql+psycopg://talk2code:<POSTGRES_PASSWORD>@127.0.0.1:5434/talk2code
# 注意：口令只在数据卷首次初始化时写入；已有卷改这里不生效，需 ALTER USER 或重建卷。
POSTGRES_PASSWORD=

# Redis 口令（生产必填；留空表示不加密码）
# 填写后需同步更新 backend/.env 的 REDIS_URL：
#   redis://:<REDIS_PASSWORD>@127.0.0.1:6380/0
REDIS_PASSWORD=
