# 环境变量和敏感文件
.env
.env.local
.env.*.local
.env.prod

# 部署方案：尚未在真实服务器验证完成，验证通过后再纳入版本控制
deploy/

# 本地文档（含服务器 IP / 成本等内部信息，不公开）
*.local.md

# Eval 运行产物（基线报告不纳入版本控制，保持 results/ 为生成态）
eval/results/

# Eval 单次运行目录：trace.db（过程）+ run.json（结果摘要），同样是生成态
eval/runs/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# Node
node_modules/

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# IDE
.idea/
.vscode/
.claude/
.workbuddy/
*.swp
*.swo
*~

# macOS
.DS_Store

# 日志
*.log
logs/

# 临时文档或者文件
tmp/
# pytest mkdtemp 遗留（backend/tests/unit 下随机后缀 tmp* 目录）
backend/tests/unit/tmp*/

# 用户工作区（运行时生成的代码产物）
backend/workspaces/
# 一键发布 ObjectStore 产物（运行时写入，slug 目录可重建）
backend/published/
# 调试/复现脚本与截图（根目录或项目根下的临时产物）
/tmp/
/probe_*.py
/repro_*.py
/sandbox_test*
/smoke_via_*
/t2c_sandbox_wrapper.html
/*.png
/*.html

# SQLite WAL 侧车文件（运行时产物）
*.db-shm
*.db-wal

# SQLite 内存库被当成文件路径时的残留
# （DATABASE_URL 配成 ":memory:" 时，有的代码路径会真的落盘一个名叫 ":memory:" 的库文件）
backend/:memory:
backend/:memory:-shm
backend/:memory:-wal

# 命令行参数被误当作文件名时留下的产物
# （如 `agent-browser screenshot --full-page <path>` 把 --full-page 当成了输出名）
/--full-page
