# LLM 配置
# LLM_PROVIDER: openai_compatible 或 anthropic_compatible
LLM_PROVIDER=openai_compatible

# OpenAI 兼容接口示例（DeepSeek / DashScope / 智谱 / ...）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# API Key（请替换为你自己的）
# DeepSeek: https://platform.deepseek.com/api_keys
# DashScope: https://bailian.console.aliyun.com/
LLM_API_KEY=your-api-key-here

# ---- 调用参数（可选，以下为默认值）----

# 温度参数 (0-2)，越高越随机
# LLM_TEMPERATURE=0.7

# 最大生成 token 数 (100-65500) —— 输出上限，非上下文窗口
# reasoning 模型会用部分 token 做内部推理，建议至少 12000 确保有足够 token 输出最终回复；
# 多文件批量写入或大文件场景建议 32000+（agnes-2.5-flash 输出硬上限 65.5K）
# LLM_MAX_TOKENS=32000

# 调用超时时间（秒），reasoning 模型建议 120+
# LLM_TIMEOUT=120

# 缺陷修复节点（defect_repair）专用超时（秒，10-300）。缺省 90。
# 只影响「构造缺陷清单后回改代码」这一次调用，调大可容忍更慢的响应。
# DEFECT_REPAIR_TIMEOUT=90

# 调用失败最大重试次数 (0-5)
# LLM_MAX_RETRIES=3

# 思考模式：coder 节点在 runtime 中强制 thinking=enabled（不依赖此开关）。
# 保持 disabled：让 team_leader/verify/memory 等小预算调用不发思考字段，
# 避免 reasoning token 挤占输出导致内容为空；coder 不受影响。
# LLM_THINKING=disabled
# 思考强度（仅当该次调用 thinking=enabled 时生效）
# coder 强制开思考，effort=high 已实证降低运行时逻辑缺陷（贪吃蛇 A/B 验证）。
# LLM_REASONING_EFFORT=high

# 是否启用 Craft 设计质量规则注入
# LLM_CRAFT_ENABLED=true

# ==================== 安全配置 ====================

# JWT 密钥（生产环境必须修改！对外可达时使用默认值将拒绝启动）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-me-to-a-long-random-string

# 调试模式（生产环境必须为 false；注意监听 0.0.0.0 时即使 debug 也会执行安全拦截）
# APP_DEBUG=false

# 显式豁免默认密钥启动检查（仅限无法配置密钥的隔离演示环境，勿在生产开启）
# ALLOW_INSECURE_SECRETS=false

# 是否关闭限流（生产环境保持 false；测试套件由 conftest 自行注入 true）
DISABLE_RATE_LIMIT=false

# 是否信任反向代理头 X-Forwarded-For（仅在可信反代之后部署才开启，否则限流 IP 可被伪造）
# TRUST_PROXY_HEADERS=false

# ==================== 演示模式 ====================
# 演示帐号是 users 表里的一行真实用户（由 manage.py demo init 创建）。
# 演示模式以它的身份登录，JWT 额外带 demo claim，所有写操作被后端守卫拦下。
# DEMO_USERNAME=demo

# ==================== 邀请码准入 ====================
# 注册必须携带有效邀请码（一次性 + 有限期）。申请/审批/发放见运营后台。
# INVITE_CODE_TTL_DAYS=7
# INVITE_REQUEST_COOLDOWN_HOURS=24
# INVITE_CODE_PREFIX=T2C-

# ==================== 邮件（邀请码发放） ====================
# 默认关闭：不配置 SMTP 也能完整跑通审批流（后台直接展示码明文供手动复制）。
# 发信与审批解耦 —— 发信失败不让审批失败，只记 delivery_status=failed 供后台重发。
# SMTP_ENABLED=false
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM=you@qq.com
# SMTP_USE_TLS=false

# ==================== 运营后台 ====================
# 后台入口 /admin/login（不在主导航暴露）。管理员账号由 manage.py admin create-user 创建。
# 后台 token 走 Authorization header（不进 cookie，与前台登录态互不覆盖）。
# ADMIN_TOKEN_EXPIRES_HOURS=2

# ==================== 中间件配置 ====================

# PostgreSQL 连接串（留空/注释则回退到 SQLite）
# 本地 Docker: postgresql+psycopg://talk2code:talk2code@localhost:5432/talk2code
# DATABASE_URL=

# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# Celery 配置（为空时自动从 REDIS_URL 派生 /1 和 /2 库）
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=3

# 是否启用 Celery 任务队列（false 时使用 ThreadPoolExecutor）
# CELERY_ENABLED=true

# ==================== 一键发布 ====================
# 已发布站点按 Host 路由到 <slug>.<PUBLISH_APEX>。留空 = 关闭该路由，
# 此时发布接口会返回 warnings，前端明确提示「链接不可用」而不是给一个打不开的地址。
#
# 本地开发（推荐）：*.localhost 由系统解析器指向 127.0.0.1，无需任何外部通配 DNS，
# 链接形如 http://<slug>.localhost:5001/
PUBLISH_APEX=localhost
PUBLISH_URL_SCHEME=http
PUBLISH_URL_PORT=5001
#
# 生产（需 *.wowcoder.cn 泛解析 + 泛域名证书；见 docs/deploy 相关说明）：
# PUBLISH_APEX=wowcoder.cn
# PUBLISH_URL_SCHEME=https
# PUBLISH_URL_PORT=

# 发布产物存储目录（留空 = backend/published）
# PUBLISH_STORE_DIR=

# 主站市集地址（已发布站点右下角 badge 的跳转目标）。
# 默认按 PUBLISH_APEX + /market 推导 —— 仅当主站就挂在 PUBLISH_APEX 这个 host 上时才正确。
# 如果主站在别的域名/子域（如 www.wowcoder.cn），**必须**显式配置成主站的市集地址，
# 否则访客从发布站点「逛逛市集」跳过去时带不上主站的登录 cookie（cookie 按 host 隔离），
# 明明登录过也会被当成游客。
# MARKET_SITE_URL=https://www.wowcoder.cn/market

# ==================== Agent 质量门禁 ====================
# coder 回环修复轮数上限（verify NEEDS_WORK 后回到 coder 的最大轮数）
# CODER_MAX_REPAIR_ROUNDS=2
# 小上下文定向修复最大轮数（冒烟确定性缺陷）
# DEFECT_REPAIR_MAX_ROUNDS=2
# 交付门禁：true 时 critical 缺陷未清零的需求转 needs_user_input（附差异报告），
# 不自动标记 finished_with_issues
# DELIVERY_GATE_STRICT=true

# ==================== 多模型能力适配（Agnes / DeepSeek 切换） ====================
# 切换厂商只需改本节。两家 thinking 参数格式完全不同，写死会在切换时静默失效或报 400。
#   【agnes-3.0-flash（当前默认）】
#       LLM_BASE_URL=https://api.agnes-ai.cn/v1
#       LLM_VENDOR=agnes
#       LLM_THINKING_FORMAT=openai            # chat_template_kwargs:{"enable_thinking":true}
#       LLM_THINKING_ECHO_REASONING=false     # Agnes 不要求回传 reasoning_content
#   【deepseek-flash（后续切换）】
#       LLM_BASE_URL=https://api.deepseek.com/v1
#       LLM_VENDOR=deepseek
#       LLM_THINKING_FORMAT=openai            # thinking:{"type":"enabled"} + reasoning_effort
#       LLM_THINKING_ECHO_REASONING=true      # tools+thinking 必须回传 reasoning_content，否则 400
#       LLM_THINKING_BUDGET_TOKENS=0          # DeepSeek 无 budget_tokens，设 0 表示不使用
LLM_VENDOR=auto
LLM_THINKING_FORMAT=auto
# agnes 的 anthropic 兼容格式专用：思考 token 预算**上限**（0 = 不限制，默认）。
# 默认不限是有意的：coder 强制开 thinking，复杂多文件生成需要长思考，
# 给它加帽会压低代码质量。想拿延迟换质量时再调小（实测 1024 → 思考量约减半、快 0.7s）。
LLM_THINKING_BUDGET_TOKENS=0
# DeepSeek 硬性要求：请求带 tools 时历史 reasoning_content 必须原样回传
LLM_THINKING_ECHO_REASONING=false
# 思考模式下剔除厂商不生效的采样参数（temperature/top_p 等）
LLM_STRIP_INVALID_PARAMS=true

# ==================== 缺陷修复：超时与输出形态 ====================
# 超时按实测吞吐反推：max_tokens ÷ LLM_MEASURED_TPS × 系数 + 开销
#   16K ÷ 60 × 1.3 + 20 ≈ 366s —— 旧的固定 90s 按标称 252.7 tok/s 拍脑袋，必然超时
#   实测吞吐：官方端点 68.6/88.7/91.8 tok/s，中转 64~78 tok/s，只有标称值约 1/3
DEFECT_REPAIR_TIMEOUT_AUTO=true
LLM_MEASURED_TPS=60
DEFECT_REPAIR_TIMEOUT_FACTOR=1.3
DEFECT_REPAIR_TIMEOUT_OVERHEAD=20
DEFECT_REPAIR_TIMEOUT_MAX=600
# diff = 只输出 SEARCH/REPLACE 增量块（1~3K tokens，20~50s，根治超时）
# whole_file = 输出整个文件（16K~32K tokens，180~360s，仅作 diff 失败时的回退）
DEFECT_REPAIR_OUTPUT_MODE=diff

# ==================== Skills 注入预算 ====================
# 名额① 常驻 core（generic + anti-ai-slop 合并精简）；名额② 场景 skill（priority 最高的 1 个）
# 此前无上限：五子棋一次命中 6 个 skill ≈15.8K 字符全量注入
SKILL_MAX_COUNT=2
SKILL_TOKEN_BUDGET=3000

# ==================== Evaluator 视觉证据 ====================
#   dom_css  ：不传图，提取 DOM + getComputedStyle 确定值（默认，零外部依赖，数值更准）
#   image_url：公网 URL（Agnes 仅支持此方式，需配 PREVIEW_PUBLIC_BASE_URL）
#   base64   ：data:image/png;base64,...（DeepSeek 支持，本地截图直传）
#   auto     ：有公网 URL 用 url，否则本地文件 base64，都不可用则降级 dom_css
EVALUATOR_VISION_MODE=dom_css
EVALUATOR_VISION_DETAIL=low
EVALUATOR_VISION_MAX_IMAGES=2
# 视觉硬伤（对比度 <3:1 / 点区 <24px / 字号 <10px）是否作为确定性缺陷进入修复循环。
# 开启后「页面难看」第一次可判定、可修复（代价：这类页面走深度评估 + 一轮定向修复）；
# 关闭则回到"UI 丑但不阻塞"，视觉证据仍会进 evaluator 的评估内容。
UI_LINT_AS_DEFECT=true

# ==================== LLM 错误分类与限流退避 ====================
# 401/403（Key 失效 / 套餐被禁）永不重试——同一个 Key 重试多少次都是同一个拒绝。
# 此前 chat() 路径把 401 当网络抖动重试 3 次，单日堆出 229 行 401 日志，
# 前端只显示「已达最大重试次数」，看不出根因。现已按状态码分档：
#   auth(401/403)   → 立即失败 + 给出可执行的排查提示（含 Key 指纹，不泄漏完整 Key）
#   client(4xx)     → 立即失败（参数/协议问题）
#   rate_limit(429) → 用下面的长退避重试（服务端有 Retry-After 则以服务端为准）
#   transient(5xx)  → 原有短指数退避
# 429 退避上限默认 60s（而非通用退避的 10s）：限流窗口通常按分钟计，
# 10s 后重试基本必然再撞一次。免费额度账号被自己的批量任务打满时尤其明显。
LLM_RATE_LIMIT_BACKOFF_BASE_S=5.0
LLM_RATE_LIMIT_BACKOFF_MAX_S=60.0
