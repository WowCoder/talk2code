# LLM 配置
# LLM_PROVIDER: openai_compatible 或 anthropic_compatible
LLM_PROVIDER=openai_compatible

# OpenAI 兼容接口示例（DeepSeek / DashScope / 智谱 / ...）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# API Key（请替换为你自己的）
# DeepSeek: https://platform.deepseek.com/api_keys
# DashScope: https://bailian.console.aliyun.com/
LLM_API_KEY=your-api-key-here

# ---- 调用参数（可选，以下为默认值）----

# 温度参数 (0-2)，越高越随机
# LLM_TEMPERATURE=0.7

# 最大生成 token 数 (100-32000)
# reasoning 模型（如 DeepSeek-R1）会用部分 token 做内部推理，
# 建议至少 12000 确保有足够 token 输出最终回复
# LLM_MAX_TOKENS=12000

# 调用超时时间（秒），reasoning 模型建议 120+
# LLM_TIMEOUT=120

# 调用失败最大重试次数 (0-5)
# LLM_MAX_RETRIES=3

# 思考模式：DeepSeek V4 默认开启且 effort=high，会消耗大量 reasoning token（纯浪费）。
# 设为 disabled 关闭思考以提速；需要更高质量时可改 enabled。
# LLM_THINKING=disabled
# 思考强度（仅当 LLM_THINKING=enabled 时生效）
# LLM_REASONING_EFFORT=high

# 是否启用 Craft 设计质量规则注入
# LLM_CRAFT_ENABLED=true

# ==================== 安全配置 ====================

# JWT 密钥（生产环境必须修改！对外可达时使用默认值将拒绝启动）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-me-to-a-long-random-string

# 调试模式（生产环境必须为 false；注意监听 0.0.0.0 时即使 debug 也会执行安全拦截）
# APP_DEBUG=false

# 显式豁免默认密钥启动检查（仅限无法配置密钥的隔离演示环境，勿在生产开启）
# ALLOW_INSECURE_SECRETS=false

# 是否关闭限流（生产环境保持 false；测试套件由 conftest 自行注入 true）
DISABLE_RATE_LIMIT=false

# 是否信任反向代理头 X-Forwarded-For（仅在可信反代之后部署才开启，否则限流 IP 可被伪造）
# TRUST_PROXY_HEADERS=false

# ==================== 中间件配置 ====================

# PostgreSQL 连接串（留空/注释则回退到 SQLite）
# 本地 Docker: postgresql+psycopg://talk2code:talk2code@localhost:5432/talk2code
# DATABASE_URL=

# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# Celery 配置（为空时自动从 REDIS_URL 派生 /1 和 /2 库）
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=3

# 是否启用 Celery 任务队列（false 时使用 ThreadPoolExecutor）
# CELERY_ENABLED=true
