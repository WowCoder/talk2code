# Talk2Code 生产环境变量模板
# 由 deploy.sh 复制为 backend/.env 并替换域名。修改后重启 gunicorn / celery 生效。

# ==================== LLM（远程 API，无需本地算力） ====================
LLM_PROVIDER=openai_compatible
LLM_API_KEY=请改为你的真实 Key
LLM_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ==================== 数据库 / 缓存（Docker: PG 5434 / Redis 6380） ====================
# 必须指向 PostgreSQL，留空会回退 SQLite 导致 pgvector + HNSW 索引全部失效
DATABASE_URL=postgresql+psycopg://talk2code:talk2code@127.0.0.1:5434/talk2code
REDIS_URL=redis://127.0.0.1:6380/0

# ==================== Celery 异步任务 ====================
CELERY_ENABLED=true
CELERY_WORKER_CONCURRENCY=1

# ==================== 安全（生产必改） ====================
# 改为随机长字符串: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-long-string
ALLOW_INSECURE_SECRETS=false

# ==================== 反向代理 ====================
# 部署在可信反代之后必须开启，否则 flask-limiter 按反代 IP 算，全员共享一个限流桶
TRUST_PROXY_HEADERS=true
CORS_ORIGINS=https://your.domain.com
PREVIEW_PUBLIC_BASE_URL=https://your.domain.com

# ==================== 应用 ====================
APP_PORT=5001
APP_DEBUG=false
LOG_LEVEL=INFO
