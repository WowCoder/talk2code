# Talk2Code 生产环境变量模板
# 由 deploy.sh 复制为 backend/.env 并自动替换域名与随机口令。
# 修改后重启 gunicorn / celery（systemctl restart talk2code talk2code-celery）生效。
#
# ⚠️ __XXX__ 形式的占位符由 deploy.sh 自动填充；手工部署时请逐个替换。
# 本文件入库，切勿写入真实密钥。

# ==================== LLM（远程 API，无需本地算力） ====================
LLM_PROVIDER=openai_compatible
# 必填：留空时非调试模式会拒绝启动
LLM_API_KEY=__LLM_API_KEY__
LLM_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ==================== 数据库 / 缓存 ====================
# 必须指向 PostgreSQL：留空会静默回退 SQLite，pgvector + HNSW 索引全部失效，
# 且多 gunicorn worker 下 SQLite 写锁竞争会导致任务状态错乱。
# 口令必须与仓库根目录 .env 的 POSTGRES_PASSWORD / REDIS_PASSWORD 一致。
DATABASE_URL=postgresql+psycopg://talk2code:__POSTGRES_PASSWORD__@127.0.0.1:5434/talk2code
REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6380/0

# 强制要求 PostgreSQL：DATABASE_URL 为空时拒绝启动，避免静默跑 SQLite
REQUIRE_POSTGRES=true

# ==================== Celery 异步任务 ====================
CELERY_ENABLED=true
CELERY_WORKER_CONCURRENCY=1

# ==================== 安全（生产必改） ====================
# 用默认值且对外可达时应用会拒绝启动（factory.py 的启动检查）
JWT_SECRET_KEY=__JWT_SECRET__
ALLOW_INSECURE_SECRETS=false

# ==================== 反向代理 ====================
# 部署在可信反代之后必须开启，否则限流按反代 IP 计算，全员共用一个限流桶。
# ⚠️ 必须配合 nginx 的 `proxy_set_header X-Forwarded-For $remote_addr;`（覆盖而非追加），
#    否则客户端可自带 XFF 首段绕过限流。
TRUST_PROXY_HEADERS=true
CORS_ORIGINS=https://__DOMAIN__

# ★ 同源反代部署**必须留空**。该值只被服务端验收浏览器消费
#   （preview_token.make_preview_url(absolute=True)）——填上公网域名，等于让
#   验证浏览器去访问本机自己的公网地址，白担 TLS 与回环 NAT 风险（还要额外
#   依赖沙箱 allow_hosts 放行）。留空则回落到 http://127.0.0.1:<APP_PORT>，
#   正好命中沙箱默认的 loopback 白名单。前端预览 iframe 走同源相对路径，
#   从不读这个值。仅当 EVALUATOR_VISION_MODE=image_url（需公网图片地址）时才填。
PREVIEW_PUBLIC_BASE_URL=

# ==================== 一键发布 ====================
# 已发布站点 Host 路由的 apex。留空会让「一键发布」拿不到可访问链接。
# 前置条件：① DNS 加 *.<APEX> 泛解析指向本机
#           ② nginx 配置 *. <APEX> 的 server 块，反代到 5001（见 deploy/nginx.conf）
#           ③ 泛域名证书（云厂商免费证书通常不含通配符，用 acme.sh 走 DNS 验证申请）
PUBLISH_APEX=__APEX__
PUBLISH_URL_SCHEME=https
PUBLISH_URL_PORT=

# ==================== 应用 ====================
APP_PORT=5001
APP_DEBUG=false
LOG_LEVEL=INFO
